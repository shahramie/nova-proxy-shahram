{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-proxy-shahram",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "0f8887a7-5451-4817-94be-bf172e7731d6","database_name": "nova-proxy-shahram" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "ccbd6da640574255a5918a30fe6cb22b" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
